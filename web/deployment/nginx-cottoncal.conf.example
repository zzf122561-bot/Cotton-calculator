# 把 /cottoncal/ 和磁盘路径替换为实际值。
location /cottoncal/ {
    alias /srv/www/cottoncal/;
    index index.html;
    try_files $uri $uri/ /cottoncal/index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
}

location = /cottoncal/sw.js {
    alias /srv/www/cottoncal/sw.js;
    default_type application/javascript;
    add_header Cache-Control "no-cache";
    add_header Service-Worker-Allowed "/cottoncal/";
}

location = /cottoncal/manifest.webmanifest {
    alias /srv/www/cottoncal/manifest.webmanifest;
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
}

location = /cottoncal/index.html {
    alias /srv/www/cottoncal/index.html;
    add_header Cache-Control "no-cache";
}

