# Public, non-secret runtime values. Production must use HTTPS.
MACHINE_DATABASE=/app/data/machine.sqlite3
MACHINE_ORIGIN=https://tool1.xuesui.xin
# REQUIRED. Intentionally empty: resident startup fails closed until configured.
# List the actual IPs of proxies CONNECTING TO THE CONTAINER, not public clients.
# Determine them at deployment; do not guess or hard-code a Docker bridge address.
# Comma-separated individual IPv4/IPv6 literals only. No *, CIDR, hostnames,
# ports, scoped IPv6, unspecified or multicast addresses. No automatic .env loading.
FORWARDED_ALLOW_IPS=
# No bootstrap variable: the resident API never reads initialization material.
# MACHINE_DEV_INSECURE=1 is only accepted with an explicit HTTP loopback origin.
